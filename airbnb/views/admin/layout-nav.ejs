<style>
  .admin-shell { display: flex; gap: 24px; }
  .admin-side { width: 220px; flex-shrink: 0; background: #1c2733; border-radius: 14px; padding: 18px; position: sticky; top: 110px; height: fit-content; }
  .admin-side h5 { color: #fff; font-weight: 600; margin-bottom: 16px; }
  .admin-side a { display: block; color: #d3d7de; text-decoration: none; padding: 8px 12px; border-radius: 8px; margin-bottom: 4px; font-size: 14px; }
  .admin-side a:hover, .admin-side a.active { background: #c14a2b; color: #fff; }
  .admin-main { flex: 1; min-width: 0; }
  .stat-card { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 18px; }
  .stat-label { color: #777; font-size: 13px; text-transform: uppercase; letter-spacing: .4px; }
  .stat-value { font-size: 28px; font-weight: 700; color: #1c2733; margin-top: 4px; }
  .admin-card { background: #fff; border: 1px solid #eee; border-radius: 12px; padding: 18px; }
  .admin-table { width: 100%; font-size: 14px; }
  .admin-table th { text-align: left; padding: 10px; background: #fafafa; border-bottom: 1px solid #eee; }
  .admin-table td { padding: 10px; border-bottom: 1px solid #f3f3f3; vertical-align: middle; }
  .pill { padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill-ok { background: #d1e7dd; color: #0f5132; }
  .pill-warn { background: #fff3cd; color: #664d03; }
  .pill-bad { background: #f8d7da; color: #842029; }
</style>

<aside class="admin-side">
  <h5><i class="fa-solid fa-shield"></i> Admin</h5>
  <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>"><i class="fa-solid fa-gauge me-2"></i>Dashboard</a>
  <a href="/admin/users" class="<%= active === 'users' ? 'active' : '' %>"><i class="fa-solid fa-users me-2"></i>Users</a>
  <a href="/admin/listings" class="<%= active === 'listings' ? 'active' : '' %>"><i class="fa-solid fa-house me-2"></i>Listings</a>
  <a href="/admin/bookings" class="<%= active === 'bookings' ? 'active' : '' %>"><i class="fa-solid fa-calendar-check me-2"></i>Bookings</a>
  <a href="/admin/reviews" class="<%= active === 'reviews' ? 'active' : '' %>"><i class="fa-solid fa-star me-2"></i>Reviews</a>
  <a href="/listings" style="margin-top: 14px; border-top: 1px solid #2e3845; padding-top: 14px;"><i class="fa-solid fa-arrow-left me-2"></i>Back to site</a>
</aside>
