  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const navbarContainer = document.getElementById('hideable-navbar-container');
      const tabButtons = document.querySelectorAll('.hideable-navbar-buttons');
      const tabPanes = document.querySelectorAll('.tab-pane');
      const tabContent = document.querySelector('.hideable-navbar-tabs-content');

      // Close tabs when clicking outside
      document.addEventListener('click', function(e) {
        // Check if click is outside navbar container and not inside tab content
        if (!navbarContainer.contains(e.target) && !tabContent.contains(e.target)) {
          // Remove active class from all buttons
          tabButtons.forEach(btn => {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
          });
          // Remove active and show classes from all panes
          tabPanes.forEach(pane => {
            pane.classList.remove('active', 'show');
          });
        }
      });

      // Prevent closing when clicking inside tab content
      tabContent.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    });
  </script>

