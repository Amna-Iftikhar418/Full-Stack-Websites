<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">

  <symbol id="check-circle-fill" fill="currentColor" viewBox="0 0 16 16">
    <path
      d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417
         5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75
         0 0 0-.01-1.05z" />
  </symbol>

  <symbol id="exclamation-triangle-fill" fill="currentColor" viewBox="0 0 16 16">
    <path
      d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889
         0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552
         0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1
         0 2 1 1 0 0 1 0-2z" />
  </symbol>
</svg>


<% if (locals.success && locals.success.length > 0) { %>
  <% locals.success.forEach(msg => { %>
    <div class="alert alert-success d-flex align-items-center shadow-sm rounded-3 p-3 mb-3 border-0 auto-dismiss-flash"
         role="alert"
         style="background-color: #d1e7dd; color: #0f5132;">
      <svg class="bi flex-shrink-0 me-2" width="28" height="28" role="img" aria-label="Success:">
        <use xlink:href="#check-circle-fill" />
      </svg>
      <div class="flex-grow-1 fw-semibold">
        <%= msg %>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<% if (locals.error && locals.error.length > 0) { %>
  <% locals.error.forEach(msg => { %>
    <div class="alert alert-danger d-flex align-items-center shadow-sm rounded-3 p-3 mb-3 border-0 auto-dismiss-flash"
         role="alert"
         style="background-color: #f8d7da; color: #842029;">
      <svg class="bi flex-shrink-0 me-2" width="28" height="28" role="img" aria-label="Error:">
        <use xlink:href="#exclamation-triangle-fill" />
      </svg>
      <div class="flex-grow-1 fw-semibold">
        <%= msg %>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

<script>
    // Auto-dismiss flash messages after 3 seconds
    document.addEventListener('DOMContentLoaded', function() {
        const flashAlerts = document.querySelectorAll('.auto-dismiss-flash');
        flashAlerts.forEach(function(alert) {
            setTimeout(function() {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }, 3000);
        });
    });
</script>
