<% layout("layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm text-center" style="border-radius: 14px;">
      <div class="card-body p-5">
        <div style="font-size: 56px; color: #c14a2b;"><i class="fa-solid fa-circle-xmark"></i></div>
        <h2 class="mt-3">Payment cancelled</h2>
        <p class="text-muted">No charge was made. You can retry whenever you're ready.</p>

        <form action="/bookings/<%= booking._id %>/checkout" method="POST" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger">Try payment again</button>
        </form>
        <a href="/bookings/guest" class="btn btn-outline-secondary ms-2">Back to bookings</a>
      </div>
    </div>
  </div>
</div>
