<% layout("layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm text-center" style="border-radius: 14px;">
      <div class="card-body p-5">
        <div style="font-size: 56px; color: #198754;"><i class="fa-solid fa-circle-check"></i></div>
        <h2 class="mt-3">Payment successful</h2>
        <p class="text-muted">Your booking for <strong><%= booking.listing.title %></strong> is confirmed.</p>
        <ul class="list-unstyled text-start d-inline-block mt-3">
          <li><strong>Check-in:</strong> <%= booking.checkIn.toDateString() %></li>
          <li><strong>Check-out:</strong> <%= booking.checkOut.toDateString() %></li>
          <li><strong>Total paid:</strong> $<%= booking.totalPrice %></li>
          <li><strong>Status:</strong> <%= booking.status %></li>
        </ul>
        <div class="mt-4">
          <a href="/bookings/guest" class="btn btn-danger">View my bookings</a>
          <a href="/listings" class="btn btn-outline-secondary">Back to listings</a>
        </div>
      </div>
    </div>
  </div>
</div>
