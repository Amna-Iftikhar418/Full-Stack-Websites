<% layout("layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card shadow-sm" style="border-radius: 14px;">
      <div class="card-body p-4">
        <h3 class="mb-3"><i class="fa-solid fa-envelope"></i> Verify your email</h3>
        <p>We sent a verification link to <strong><%= user.email %></strong>.</p>
        <p>Click the link in that email to activate your account. Some features (booking, messaging) require a verified email.</p>

        <form action="/verify/resend" method="POST" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger rounded-pill">Resend verification email</button>
        </form>

        <a href="/listings" class="btn btn-outline-secondary ms-2">Continue browsing</a>

        <% if (!process.env.GMAIL_USER) { %>
          <div class="alert alert-info mt-4 mb-0">
            <strong>Dev mode:</strong> email credentials are not configured. Check your server console for the verification link.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
