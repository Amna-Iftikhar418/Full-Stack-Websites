<% layout("layouts/boilerplate") -%>

<div class="container my-5" style="padding-top: 20px;">
    <div class="row">
        <!-- Profile Header -->
        <div class="col-12 mb-4">
            <div class="card shadow-sm profile-header-card">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <% if (user.profileImage && user.profileImage.url) { %>
                            <img src="<%= user.profileImage.url %>"
                                 alt="<%= user.username %>"
                                 class="rounded-circle profile-avatar">
                        <% } else { %>
                            <div class="rounded-circle profile-avatar-placeholder d-inline-flex align-items-center justify-content-center">
                                <span style="font-size: 60px; color: white;"><%= user.username.charAt(0).toUpperCase() %></span>
                            </div>
                        <% } %>
                    </div>
                    <h2 class="profile-username">
                        <% if (user.firstName || user.lastName) { %>
                            <%= user.firstName %> <%= user.lastName %>
                        <% } else { %>
                            <%= user.username %>
                        <% } %>
                        <% if (typeof hostStats !== 'undefined' && hostStats && hostStats.isSuperhost) { %>
                            <span class="badge bg-warning text-dark ms-2" style="vertical-align: middle;">
                                <i class="fa-solid fa-medal me-1"></i>Superhost
                            </span>
                        <% } %>
                    </h2>
                    <p class="text-muted mb-2">@<%= user.username %></p>
                    <p class="profile-email"><%= user.email %></p>
                    <% if (typeof hostStats !== 'undefined' && hostStats && hostStats.totalListings > 0) { %>
                        <div class="d-flex justify-content-center gap-4 flex-wrap small text-muted mt-2">
                            <span><i class="fa-solid fa-star text-warning me-1"></i><%= hostStats.avgRating || '—' %> avg rating</span>
                            <span><i class="fa-solid fa-comments me-1"></i><%= hostStats.totalReviews %> reviews</span>
                            <span><i class="fa-solid fa-reply me-1"></i><%= hostStats.responseRate %>% response rate</span>
                        </div>
                    <% } %>
                    <a href="/profile/edit" class="btn btn-profile mt-2">
                        <i class="fas fa-edit me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Profile Details -->
        <div class="col-md-6 mb-4">
            <div class="card profile-detail-card">
                <div class="card-header">
                    <h5><i class="fas fa-user me-2"></i> Profile Information</h5>
                </div>
                <div class="card-body">
                    <div class="profile-detail-item">
                        <div class="profile-detail-label">First Name</div>
                        <div class="profile-detail-value"><%= user.firstName || 'Not provided' %></div>
                    </div>
                    <div class="profile-detail-item">
                        <div class="profile-detail-label">Last Name</div>
                        <div class="profile-detail-value"><%= user.lastName || 'Not provided' %></div>
                    </div>
                    <div class="profile-detail-item">
                        <div class="profile-detail-label">Phone</div>
                        <div class="profile-detail-value"><%= user.phone || 'Not provided' %></div>
                    </div>
                    <div class="profile-detail-item">
                        <div class="profile-detail-label">Bio</div>
                        <div class="profile-detail-value"><%= user.bio || 'No bio yet' %></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="col-md-6 mb-4">
            <div class="card profile-detail-card">
                <div class="card-header">
                    <h5><i class="fas fa-link me-2"></i> Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a href="/bookings" class="list-group-item quick-link-item">
                            <i class="fas fa-calendar-check me-2"></i> My Bookings
                        </a>
                        <a href="/listings/liked" class="list-group-item quick-link-item">
                            <i class="fas fa-heart me-2"></i> Saved Listings
                        </a>
                        <a href="/listings?owner=<%= user._id %>" class="list-group-item quick-link-item">
                            <i class="fas fa-home me-2"></i> My Listings
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Stats -->
        <div class="col-12">
            <div class="card stats-card">
                <div class="card-header">
                    <h5><i class="fas fa-chart-bar me-2"></i> Account Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="stats-item">
                                <h3><i class="fas fa-home"></i></h3>
                                <p>My Listings</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-item">
                                <h3><i class="fas fa-calendar"></i></h3>
                                <p>My Bookings</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-item">
                                <h3><i class="fas fa-heart"></i></h3>
                                <p>Saved Places</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
