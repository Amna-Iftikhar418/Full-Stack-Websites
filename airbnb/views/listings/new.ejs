<% layout("layouts/boilerplate") -%>

  <div class="row mt-4">
    <div class="col-8 offset-2 ">
      <div class="home-icon  w-100" style="height: 70px;">

        <div class="d-flex gap-2 ">
          <div class="d-flex justify-content-center align-items-center gap-3 ">
            <img class="home animated-images" width="70px" src="/images/home.png" alt="">

            <div>

              <a href="/listings"><i class="fa-solid fa-circle-left"></i></a>
            </div>


          </div>


        </div>
      </div>
      <h3><b>CREATE A NEW LIST</b></h3>
      <form method="post" action="/listings?_csrf=<%= csrfToken %>" class="needs-validation" novalidate enctype="multipart/form-data">


        <div class="mb-2">
          <label class="form-label" for="title">Title:</label>
          <input class="form-control shadow-lg" id="title" name="title" type="text" placeholder="enter title" required>
          <div class="invalid-feedback">Please fill this field</div>
        </div>



        <div class="mb-2">
          <label class="form-label" for="description">Description:</label>
          <textarea class="form-control shadow-lg" id="description" name="description" required></textarea>
          <div class="invalid-feedback">Please enter descrition here</div>
        </div>

        <input type="hidden" name="date" value="<%= preselectedDate %>">


        <div class="mb-2">
          <label class="form-label" for="images">Upload Images (up to 6):</label>
          <input class="form-control shadow-lg" id="images" name="images" type="file" accept="image/jpeg,image/png,image/jpg,image/webp" multiple>
          <small class="text-muted">The first image will be used as the cover photo.</small>
        </div>

        <div class="row">

          <div class="mb-2 col-md-4">
            <label class="form-label" for="price">Price:</label>
            <input class="form-control shadow-lg" id="price" name="price" type="number" min="1" step="0.01" placeholder="enter price" required>
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>

          <div class="mb-2 col-md-8">
            <label class="form-label" for="country">Country:</label>
            <input class="form-control shadow-lg" id="country" name="country" type="text"
              placeholder="enter country name here" required>

          </div>
          <div class="invalid-feedback">Please enter valid country name</div>
        </div>
        <div class="mb-2">
          <label class="form-label" for="location">Location:</label>
          <input class="form-control shadow-lg" id="location" name="location" type="text"
            placeholder="enter location here" required>
          <div class="invalid-feedback">Please enter valid location</div>
        </div>

   <div class="mb-3">
  <label for="category" class="form-label">Category</label>
  <select class="form-select" name="category" id="category" required>
    <option value="" disabled selected>Select a category</option>
    <option value="Trending">Trending</option>
    <option value="Farms">Farms</option>
    <option value="Room">Room</option>
    <option value="Mountain">Mountain</option>
    <option value="Amazing Views">Amazing Views</option>
    <option value="Pool">Pool</option>
    <option value="Castles">Castles</option>
    <option value="Beach">Beach</option>
    <option value="Iconic City">Iconic City</option>
  </select>
  <div class="invalid-feedback">Please select a category</div>
</div>

<h5 class="mt-4 mb-2">Capacity</h5>
<div class="row">
  <div class="mb-2 col-md-3">
    <label class="form-label" for="maxGuests">Max guests</label>
    <input class="form-control" name="maxGuests" id="maxGuests" type="number" min="1" step="1" value="2">
  </div>
  <div class="mb-2 col-md-3">
    <label class="form-label" for="bedrooms">Bedrooms</label>
    <input class="form-control" name="bedrooms" id="bedrooms" type="number" min="0" step="1" value="1">
  </div>
  <div class="mb-2 col-md-3">
    <label class="form-label" for="beds">Beds</label>
    <input class="form-control" name="beds" id="beds" type="number" min="0" step="1" value="1">
  </div>
  <div class="mb-2 col-md-3">
    <label class="form-label" for="bathrooms">Bathrooms</label>
    <input class="form-control" name="bathrooms" id="bathrooms" type="number" min="0" step="0.5" value="1">
  </div>
</div>

<h5 class="mt-3 mb-2">Pricing options</h5>
<div class="row">
  <div class="mb-2 col-md-4">
    <label class="form-label" for="cleaningFee">Cleaning fee (₹)</label>
    <input class="form-control" name="cleaningFee" id="cleaningFee" type="number" min="0" step="1" value="0">
  </div>
  <div class="mb-2 col-md-4">
    <label class="form-label" for="weeklyDiscount">Weekly discount (%)</label>
    <input class="form-control" name="weeklyDiscount" id="weeklyDiscount" type="number" min="0" max="50" step="1" value="0">
  </div>
  <div class="mb-2 col-md-4">
    <label class="form-label" for="monthlyDiscount">Monthly discount (%)</label>
    <input class="form-control" name="monthlyDiscount" id="monthlyDiscount" type="number" min="0" max="50" step="1" value="0">
  </div>
</div>

<div class="mb-2">
  <label class="form-label" for="minStay">Minimum stay (nights)</label>
  <input class="form-control" name="minStay" id="minStay" type="number" min="1" step="1" value="1" style="max-width:180px;">
</div>

<h5 class="mt-3 mb-2">Amenities</h5>
<div class="row mb-3">
  <% const amenityList = [
    { key: 'wifi', label: 'Wi‑Fi' },
    { key: 'kitchen', label: 'Kitchen' },
    { key: 'parking', label: 'Parking' },
    { key: 'pool', label: 'Pool' },
    { key: 'ac', label: 'Air conditioning' },
    { key: 'heating', label: 'Heating' },
    { key: 'washer', label: 'Washer' },
    { key: 'tv', label: 'TV' },
    { key: 'workspace', label: 'Workspace' },
    { key: 'pets', label: 'Pets allowed' },
    { key: 'gym', label: 'Gym' },
    { key: 'breakfast', label: 'Breakfast' }
  ]; %>
  <% amenityList.forEach(function(a) { %>
    <div class="col-6 col-md-4">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="amenities" value="<%= a.key %>" id="amen-<%= a.key %>">
        <label class="form-check-label" for="amen-<%= a.key %>"><%= a.label %></label>
      </div>
    </div>
  <% }); %>
</div>




        <button class="btn btn-dark add-btn w-100 mb-3">ADD</button> <br><br>
      </form>
    </div>
  </div>