


<% layout("layouts/boilerplate") -%>
<%
  const activeCategory = (typeof category !== 'undefined' && category) ? category : '';
  const CATEGORY_TABS = [
    { key: 'Trending',      icon: 'fa-solid fa-fire' },
    { key: 'Farms',         icon: 'fa-solid fa-money-bill-wheat' },
    { key: 'Room',          icon: 'fa-solid fa-person-shelter' },
    { key: 'Mountain',      icon: 'fa-solid fa-mountain-sun' },
    { key: 'Amazing Views', icon: 'fa-solid fa-mountain-city' },
    { key: 'Pool',          icon: 'fa-solid fa-person-swimming' },
    { key: 'Castles',       icon: 'fa-brands fa-fort-awesome' },
    { key: 'Beach',         icon: 'fa-solid fa-umbrella-beach' },
    { key: 'Iconic City',   icon: 'fa-solid fa-building-wheat' }
  ];
%>
<div style="padding-top: 20px;">
<div style="display: flex; margin-top: 16px; gap: 24px; flex-wrap: wrap; position: relative;" id="filters">
  <% CATEGORY_TABS.forEach(function(t) { %>
    <a href="/listings/search?category=<%= encodeURIComponent(t.key) %>"
       class="text-decoration-none text-dark category-tab <%= activeCategory === t.key ? 'category-tab-active' : '' %>"
       data-category="<%= t.key %>">
      <div class="filters" style="<%= activeCategory === t.key ? 'border-bottom: 2px solid #c14a2b; color: #c14a2b;' : '' %>">
        <div><i class="<%= t.icon %>"></i></div>
        <p><%= t.key %></p>
      </div>
    </a>
  <% }); %>
  <% if (activeCategory) { %>
    <a href="#" onclick="event.preventDefault(); const p=new URLSearchParams(window.location.search); p.delete('category'); window.location='/listings/search'+(p.toString()?'?'+p.toString():'');"
       class="text-decoration-none text-muted align-self-center small">
      <i class="fa-solid fa-xmark me-1"></i>Clear category
    </a>
  <% } %>

  <!-- Advanced filters trigger (replaces tax toggle) -->
  <%
    const f = (typeof searchFilters !== 'undefined' && searchFilters) ? searchFilters : { minPrice:'', maxPrice:'', bedrooms:'', amenities: [], category: '' };
    const selAmen = Array.isArray(f.amenities) ? f.amenities : [];
    const activeCount = (f.minPrice?1:0)+(f.maxPrice?1:0)+(f.bedrooms?1:0)+((typeof searchGuests !== 'undefined' && searchGuests)?1:0)+selAmen.length;
    const hasActive = activeCount > 0;
  %>
  <div class="advanced-filters">
    <details>
      <summary class="af-summary">
        <i class="fa-solid fa-sliders"></i>
        <span>Filters</span>
        <% if (hasActive) { %>
          <span class="af-count-badge"><%= activeCount %></span>
        <% } %>
      </summary>

      <form action="/listings/search" method="GET" class="af-panel">
      <input type="hidden" name="category" value="<%= f.category || activeCategory || '' %>">

      <!-- Price & capacity -->
      <div class="af-section">
        <div class="af-section-head">
          <i class="fa-solid fa-tag"></i>
          <span>Price & capacity</span>
        </div>
        <div class="row g-3">
          <div class="col-md-3 col-6">
            <label class="af-label">Min price</label>
            <div class="af-input-wrap">
              <span class="af-input-prefix">₹</span>
              <input type="number" min="0" step="100" class="af-input" name="minPrice" value="<%= f.minPrice %>" placeholder="0">
            </div>
          </div>
          <div class="col-md-3 col-6">
            <label class="af-label">Max price</label>
            <div class="af-input-wrap">
              <span class="af-input-prefix">₹</span>
              <input type="number" min="0" step="100" class="af-input" name="maxPrice" value="<%= f.maxPrice %>" placeholder="Any">
            </div>
          </div>
          <div class="col-md-3 col-6">
            <label class="af-label">Guests</label>
            <div class="af-input-wrap">
              <i class="fa-solid fa-user-group af-input-icon"></i>
              <input type="number" min="1" step="1" class="af-input af-input-with-icon" name="guests" value="<%= (typeof searchGuests !== 'undefined' && searchGuests) ? searchGuests : '' %>" placeholder="Any">
            </div>
          </div>
          <div class="col-md-3 col-6">
            <label class="af-label">Bedrooms</label>
            <div class="af-input-wrap">
              <i class="fa-solid fa-bed af-input-icon"></i>
              <input type="number" min="0" step="1" class="af-input af-input-with-icon" name="bedrooms" value="<%= f.bedrooms %>" placeholder="Any">
            </div>
          </div>
        </div>
      </div>

      <!-- Amenities -->
      <div class="af-section">
        <div class="af-section-head">
          <i class="fa-solid fa-star"></i>
          <span>Amenities</span>
        </div>
        <% const AMENS = [
          { key: 'wifi',      label: 'Wi-Fi',     icon: 'fa-solid fa-wifi' },
          { key: 'kitchen',   label: 'Kitchen',   icon: 'fa-solid fa-utensils' },
          { key: 'parking',   label: 'Parking',   icon: 'fa-solid fa-square-parking' },
          { key: 'pool',      label: 'Pool',      icon: 'fa-solid fa-person-swimming' },
          { key: 'ac',        label: 'AC',        icon: 'fa-solid fa-snowflake' },
          { key: 'heating',   label: 'Heating',   icon: 'fa-solid fa-fire' },
          { key: 'washer',    label: 'Washer',    icon: 'fa-solid fa-soap' },
          { key: 'tv',        label: 'TV',        icon: 'fa-solid fa-tv' },
          { key: 'workspace', label: 'Workspace', icon: 'fa-solid fa-laptop' },
          { key: 'pets',      label: 'Pets',      icon: 'fa-solid fa-paw' },
          { key: 'gym',       label: 'Gym',       icon: 'fa-solid fa-dumbbell' },
          { key: 'breakfast', label: 'Breakfast', icon: 'fa-solid fa-mug-hot' }
        ]; %>
        <div class="af-amen-grid">
          <% AMENS.forEach(function(a) { %>
            <label class="af-amen-chip <%= selAmen.includes(a.key) ? 'is-selected' : '' %>">
              <input type="checkbox" name="amenities" value="<%= a.key %>" <%= selAmen.includes(a.key) ? 'checked' : '' %>>
              <i class="<%= a.icon %>"></i>
              <span><%= a.label %></span>
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Actions -->
      <div class="af-actions">
        <button type="submit" class="af-btn af-btn-primary">
          <i class="fa-solid fa-check"></i> Apply filters
        </button>
        <a href="/listings" class="af-btn af-btn-ghost">
          <i class="fa-solid fa-rotate-left"></i> Reset
        </a>
      </div>
      </form>
    </details>
  </div>
</div>

<% if (typeof category !== 'undefined' && category) { %>
  <h4 style="margin-top: 20px;" class="mb-3">Showing results for category: <span style="color: #8a3219;"><%= category %></span></h4>
<% } %>

<% if ((typeof searchCountry !== 'undefined' && searchCountry) || (typeof searchDate !== 'undefined' && searchDate) || (typeof searchCheckIn !== 'undefined' && searchCheckIn) || (typeof searchGuests !== 'undefined' && searchGuests)) { %>
  <h4 style="margin-top: 20px;" class="mb-3">Showing results
    <% if (typeof searchCountry !== 'undefined' && searchCountry) { %>
      for: <span style="color: #8a3219;"><%= searchCountry %></span>
    <% } %>
    <% if (typeof searchCheckIn !== 'undefined' && searchCheckIn) { %>
      · available from <span style="color: #8a3219;"><%= searchCheckIn %></span>
      <% if (typeof searchCheckOut !== 'undefined' && searchCheckOut) { %>
        to <span style="color: #8a3219;"><%= searchCheckOut %></span>
      <% } %>
    <% } else if (typeof searchDate !== 'undefined' && searchDate) { %>
      on <span style="color: #8a3219;"><%= searchDate %></span>
    <% } %>
    <% if (typeof searchGuests !== 'undefined' && searchGuests) { %>
      · <span style="color: #8a3219;"><%= searchGuests %> guest<%= searchGuests > 1 ? 's' : '' %></span>
    <% } %>
  </h4>
<% } %>
<div>
  
<% if (success && success.length > 0) { %>
  <% success.forEach(msg => { %>
    <div class="alert alert-success d-flex align-items-center shadow-sm rounded-3 p-3 mb-3 border-0" 
         role="alert"
         style="background-color: #d1e7dd; color: #0f5132;">
      <svg class="bi flex-shrink-0 me-2" width="28" height="28" role="img" aria-label="Success:">
        <use xlink:href="#check-circle-fill" />
      </svg>
      <div class="flex-grow-1 fw-semibold">
        <%= msg %>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }) %>
<% } %>

</div>
<div class="index row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

  <% for (let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing.id %>" class="text-decoration-none text-dark">
        <div class="card index-card shadow-sm border-0 rounded-4 overflow-hidden h-100">
          <!-- Image -->
          <div class="image-wrapper">
            <% const coverUrl = (listing.images && listing.images.length && listing.images[0].url) || (listing.image && listing.image.url) || '/images/home.png'; %>
            <img src="<%= coverUrl %>" class="index-card-img-top" alt="listing_image">
            <div class="image-overlay"></div>
            
            <% if (listing.isAvailable === false) { %>
              <div class="availability-badge availability-badge-unavailable">
                <i class="fa-solid fa-ban me-1"></i>Unavailable
              </div>
              <div class="listing-unavailable-overlay">
                <span><i class="fa-solid fa-ban me-2"></i>Unavailable</span>
              </div>
            <% } else { %>
              <div class="availability-badge availability-badge-available">
                Available
              </div>
            <% } %>
            
            <!-- Favorite Button -->
            <% if (curruser) { %>
              <button class="favorite-btn like-btn" data-listing-id="<%= listing._id %>" data-liked="<%= curruser.likes && curruser.likes.includes(listing._id.toString()) %>">
                <i class="<%= curruser.likes && curruser.likes.includes(listing._id.toString()) ? 'fa-solid' : 'fa-regular' %> fa-heart <%= curruser.likes && curruser.likes.includes(listing._id.toString()) ? 'text-danger' : '' %>"></i>
              </button>
            <% } else { %>
              <button class="favorite-btn" onclick="event.preventDefault(); event.stopPropagation(); window.location='/login';">
                <i class="fa-regular fa-heart"></i>
              </button>
            <% } %>
          </div>

          <!-- Body -->
          <div class="index-card-body">
            <h5 class="card-title"><%= listing.title %></h5>

            <p class="location-text">
              <i class="fa-solid fa-location-dot"></i>
              <%= listing.location || "Location not specified" %><% if (listing.country) { %>, <%= listing.country %><% } %>
            </p>

            <div class="price-section">
              <span class="price-amount">&#8377;<%= listing.price.toLocaleString('en-IN') %></span>
              <span class="price-period">&nbsp;/ night</span>
              <span class="price-cta" aria-hidden="true">
                <i class="fa-solid fa-arrow-right"></i>
              </span>
            </div>

          </div>
          <span class="card-shine" aria-hidden="true"></span>

        </div>
      </a>
    </div>
  <% } %>
</div>
</div>

<script>
  // Close advanced-filters dropdown when clicking outside.
  document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(e) {
      const d = document.querySelector('.advanced-filters details');
      if (d && d.open && !d.contains(e.target)) {
        d.removeAttribute('open');
      }
    });
  });

  // Category tabs: merge into current query so advanced filters are preserved.
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.category-tab').forEach(function(a) {
      a.addEventListener('click', function(e) {
        e.preventDefault();
        const params = new URLSearchParams(window.location.search);
        const active = params.get('category');
        const clicked = this.dataset.category;
        if (active === clicked) {
          params.delete('category'); // clicking the active tab clears it
        } else {
          params.set('category', clicked);
        }
        window.location = '/listings/search?' + params.toString();
      });
    });
  });

  // Like Button functionality
  document.addEventListener('DOMContentLoaded', function() {
    const likeButtons = document.querySelectorAll('.like-btn');
    
    likeButtons.forEach(button => {
      button.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const listingId = this.dataset.listingId;
        const icon = this.querySelector('i');
        
        try {
          const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
          const response = await fetch(`/listings/${listingId}/like`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'csrf-token': csrfToken
            }
          });
          
          if (response.ok) {
            const data = await response.json();
            
            // Toggle icon
            if (data.liked) {
              icon.classList.remove('fa-regular');
              icon.classList.add('fa-solid', 'text-danger');
              this.dataset.liked = 'true';
            } else {
              icon.classList.remove('fa-solid', 'text-danger');
              icon.classList.add('fa-regular');
              this.dataset.liked = 'false';
            }
            
            // Update navbar badge
            updateLikeBadge(data.count);
          }
        } catch (error) {
          console.error('Error toggling like:', error);
        }
      });
    });
    
    function updateLikeBadge(count) {
      const heartIcons = document.querySelectorAll('.fa-heart');
      heartIcons.forEach(icon => {
        const btn = icon.closest('.btn');
        if (btn && btn.href && btn.href.includes('/listings/liked')) {
          const badge = btn.querySelector('.badge');
          if (count > 0) {
            if (badge) {
              badge.textContent = count;
            } else {
              const badge = document.createElement('span');
              badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger';
              badge.textContent = count;
              btn.appendChild(badge);
            }
          } else {
            if (badge) {
              badge.remove();
            }
          }
        }
      });
    }
  });
</script>
